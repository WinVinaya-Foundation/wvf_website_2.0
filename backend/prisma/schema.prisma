generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DonationScheme {
  STUDENT_ENGLISH
  STUDENT_ENGLISH_SOFTSKILLS
  STUDENT_ENGLISH_SOFTSKILLS_IT_BFSI
  RURAL_ENTREPRENEURS
  GENERAL
}

enum DonationStatus {
  CREATED
  PAID
  FAILED
  CANCELLED
}

model Donation {
  id          String         @id @default(cuid())
  reference   String         @unique
  scheme      DonationScheme
  schemeLabel String
  amountPaise Int
  currency    String         @default("INR")

  donorName    String
  donorEmail   String
  donorPan     String
  donorMobile  String
  donorPhone   String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String

  razorpayOrderId   String    @unique
  razorpayPaymentId String?   @unique
  razorpaySignature String?
  paymentMethod     String?
  vpa               String?
  razorpayCreatedAt DateTime?

  status DonationStatus @default(CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([donorEmail])
  @@index([createdAt])
}

enum ReportCategory {
  ANNUAL
  FINANCIAL
  LEGAL
  RESEARCH
}

model Report {
  id          String         @id @default(cuid())
  title       String
  category    ReportCategory
  year        String?
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int
  mimeType    String
  isActive    Boolean        @default(true)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([createdAt])
}

enum EventStatus {
  UPCOMING
  COMPLETED
}

enum CategoryColor {
  PRIMARY
  SECONDARY
  INFO
  WARNING
  SUCCESS
  ERROR
}

model Category {
  id        String        @id @default(cuid())
  label     String        @unique
  color     CategoryColor @default(PRIMARY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        Event[]
  galleryAlbums GalleryAlbum[]
  blogPosts     BlogPost[]
}

model Event {
  id          String      @id @default(cuid())
  title       String
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  status      EventStatus
  dateLabel   String
  isDateTBA   Boolean     @default(false)
  location    String
  description String
  ctaLabel    String?
  ctaLink     String?
  isActive    Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([isActive])
}

model GalleryAlbum {
  id         String   @id @default(cuid())
  title      String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  dateLabel  String
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos GalleryPhoto[]

  @@index([categoryId])
  @@index([isActive])
}

model GalleryPhoto {
  id      String @id @default(cuid())
  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  imageUrl  String
  caption   String?
  altText   String?
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  @@index([albumId])
}

model Story {
  id          String   @id @default(cuid())
  name        String
  role        String
  description String
  videoUrl    String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

enum TestimonialCategory {
  CANDIDATE
  CORPORATE
  INSTITUTIONAL
}

model Testimonial {
  id          String              @id @default(cuid())
  category    TestimonialCategory @default(CANDIDATE)
  name        String
  role        String
  quote       String
  disability  String?
  title       String?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  authorName    String
  authorRole    String
  publishedAt   DateTime @default(now())
  body          Json
  coverImageUrl String?
  bannerImageUrl String?
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([publishedAt])
}

model Newsletter {
  id            String   @id @default(cuid())
  title         String
  issueLabel    String
  publishedAt   DateTime @default(now())
  description   String
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  coverImageUrl String?
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([publishedAt])
}

